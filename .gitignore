# Build products. Every generated binary lives under build/, one directory per
# configuration (dev, tests, release, sanitize, coverage, fuzz, packages), so the single
# /build/ rule below covers all of them.
/build/
*.o
*.d
*.a
*.lib
*.obj

# Legacy root-level outputs from before the build/ consolidation. Kept ignored so an old
# working tree does not suddenly show a pile of stale binaries as untracked.
/drifty
/drifty.exe
/drifty_release
/drifty_release.exe
/drifty_tests
/drifty_tests.exe
/drifty_hotreload_harness
/drifty_hotreload_harness.exe
/drifty_tests_cov
/drifty_tests_cov.exe
/drifty_tests_asan
/drifty_tests_asan.exe
*.dll
*.so
*.dylib

# Windows debug artifacts
*.pdb
*.ilk
*.exp
*.idb
*.map

# Generated telemetry, replays, screenshots, reports, cards, gallery, failure bundles and
# fuzz corpora — all ephemeral run evidence, all under one ignored root. tests/baselines/ is
# committed; nothing under artifacts/ ever is.
/artifacts/
# Legacy roots, superseded by artifacts/telemetry and build/packages.
/telemetry/
/dist/
/recording_output/
/debug/record/logs/

# Reviewed, tracked, non-code inputs live under data/. The Physics Lab also SAVES named
# profiles into data/vehicles/, so scratch output is ignored there while the reviewed
# profiles and the corpus export are kept — the same rule tuning/ used to carry.
/data/vehicles/*
!/data/vehicles/default.txt
!/data/vehicles/phase3-candidate.txt
# The vehicle corpus export. Generated by
# `drifty_tests --generate-corpus data/vehicles/corpus`, but committed on purpose: it is the
# human-readable mirror of src/car_corpus.c, and the `corpus` scenario asserts every file
# still round-trips to the spec the code produces. An ignored export would rot silently and
# the next reader would trust a stale one.
!/data/vehicles/corpus/
# Legacy locations, superseded by data/, build/packages/ and artifacts/replays/.
/tuning/
/replays/
/corpus/

# Vendored dependencies fetched by CI or by the developer, rather than committed.
# third_party/raygui/ IS committed; these two are not.
/third_party/raylib-src/
/third_party/tracy/
compile_commands.json
*.gcda
*.gcno
*.gcov
/coverage/

# Editor / OS. The four committed VS Code files are the shared task, launch, and extension
# configuration; everything else under .vscode/ is personal.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
.DS_Store

# Python tooling bytecode
__pycache__/
*.pyc

# Ad-hoc verification / scratch logs (output of `mk verify` redirected to a file)
mk_verify*.log

# Tooling
.clangd
opencode.json

# Reference sprite packs used only for human visual comparison during the
# vehicle-appearance work. Not game assets; issue #7 forbids redistributing them.
/resources/sprite_examples/

# Browser inspector: node deps and the Playwright report/evidence it writes. The inspector
# itself (tools/visual/*.html, *.js, tests/) is source and IS tracked.
/tools/visual/node_modules/
/tools/visual/playwright-report/
/tools/visual/test-results/

# BEGIN oh-my-opencode-slim clonedeps
.slim/*
# END oh-my-opencode-slim clonedeps
.slim/deepwork/
